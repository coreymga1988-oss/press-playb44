{
  "name": "Content_Series",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover_image": {
      "type": "string",
      "format": "uri"
    },
    "licensor_id": {
      "type": "string"
    },
    "licensor_name": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ongoing",
        "completed",
        "upcoming"
      ],
      "default": "ongoing"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.licensor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.licensor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Section_Visibility",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "page",
        "block"
      ],
      "default": "page"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "guest": {
      "type": "boolean",
      "default": false
    },
    "viewer_free": {
      "type": "boolean",
      "default": true
    },
    "viewer_premium": {
      "type": "boolean",
      "default": true
    },
    "licensor": {
      "type": "boolean",
      "default": false
    },
    "advertiser": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "key",
    "label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}